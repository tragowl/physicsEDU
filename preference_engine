<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>행렬 기반 추천 알고리즘 시뮬레이터</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .matrix-grid {
            display: grid;
            gap: 2px;
            background-color: #e5e7eb;
            padding: 2px;
            border-radius: 4px;
            overflow-x: auto;
        }
        .cell {
            background-color: white;
            min-height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: bold;
            min-width: 60px;
        }
        .header-cell {
            background-color: #f1f5f9;
            color: #475569;
            font-weight: 700;
            font-size: 0.75rem;
        }
        .step-content {
            display: none;
        }
        .step-content.active {
            display: block;
        }
        .nav-dot.active {
            background-color: #2563eb;
            transform: scale(1.2);
        }
        
        .logic-btn {
            position: relative;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid transparent;
        }
        .logic-btn.active {
            background-color: white;
            color: #059669;
            border-color: #059669;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            transform: translateY(-1px);
        }
        .logic-btn:not(.active) {
            color: #94a3b8;
        }
        .logic-btn:not(.active):hover {
            color: #64748b;
            background-color: rgba(255,255,255,0.5);
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans">
    <div class="max-w-6xl mx-auto p-4 md:p-8">
        <!-- Header -->
        <header class="mb-10 text-center">
            <h1 class="text-3xl font-bold text-slate-800 mb-2">행렬로 배우는 데이터 교실</h1>
            <div class="flex justify-center items-center space-x-4 mt-6">
                <button onclick="showStep(1)" id="dot-1" class="nav-dot w-3 h-3 rounded-full bg-slate-300 transition-all"></button>
                <div class="w-12 h-0.5 bg-slate-200"></div>
                <button onclick="showStep(2)" id="dot-2" class="nav-dot w-3 h-3 rounded-full bg-slate-300 transition-all"></button>
                <div class="w-12 h-0.5 bg-slate-200"></div>
                <button onclick="showStep(3)" id="dot-3" class="nav-dot w-3 h-3 rounded-full bg-slate-300 transition-all"></button>
            </div>
            <div class="flex justify-center space-x-12 mt-2 text-xs font-bold text-slate-400">
                <span>STEP 1. 데이터 입력</span>
                <span>STEP 2. 유사도 분석</span>
                <span>STEP 3. 결과 리포트</span>
            </div>
        </header>

        <!-- Logic Global Selector (Moved to be accessible in Step 2 & 3) -->
        <div id="logic-selector-container" class="hidden mb-6 flex justify-center">
            <div class="flex bg-slate-100 p-1.5 rounded-2xl border border-slate-200 w-full max-w-md shadow-inner">
                <button id="logic-basic" onclick="setLogic('basic')" class="logic-btn flex-1 py-3 rounded-xl text-sm font-black transition-all active">
                    기본 코사인
                </button>
                <button id="logic-adjusted" onclick="setLogic('adjusted')" class="logic-btn flex-1 py-3 rounded-xl text-sm font-black transition-all">
                    조정된 코사인
                </button>
            </div>
        </div>

        <!-- Step 1: Data Entry -->
        <section id="step-1" class="step-content active bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-blue-600">Step 1. 데이터 행렬 구성</h2>
                    <p class="text-slate-500 text-sm">학생들의 장르별 선호도($1 \sim 5$점)를 입력하세요.</p>
                </div>
                <button onclick="addStudent()" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-blue-700 transition shadow-md">
                    + 학생 추가
                </button>
            </div>
            
            <div id="matrix-m-container" class="overflow-x-auto pb-4"></div>
            
            <div class="mt-8 flex justify-end">
                <button onclick="showStep(2)" class="bg-slate-800 text-white px-8 py-3 rounded-xl font-bold hover:bg-slate-900 transition flex items-center shadow-lg">
                    데이터 분석 시작 <span class="ml-2">→</span>
                </button>
            </div>
        </section>

        <!-- Step 2: Analysis -->
        <section id="step-2" class="step-content bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <div class="flex flex-col mb-8">
                <h2 class="text-2xl font-bold text-emerald-600 mb-1">Step 2. 기하학적 유사도 분석</h2>
                <p class="text-slate-500 text-sm">상단에서 로직을 선택하고 셀을 클릭하여 벡터의 관계를 분석해 보세요.</p>
            </div>
            
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
                <div class="lg:col-span-3">
                    <div id="heatmap-container" class="overflow-x-auto pb-4"></div>
                </div>
                
                <div class="lg:col-span-2 bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm min-h-[400px]">
                    <div id="similarity-info" class="h-full flex flex-col">
                        <div class="flex-1 flex flex-col items-center justify-center text-center p-4 text-slate-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mb-4 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
                            </svg>
                            <p>유사도 행렬의 셀을 클릭하면<br>기하학적 비교 차트가 생성됩니다.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-8 flex justify-between">
                <button onclick="showStep(1)" class="text-slate-500 font-bold hover:text-slate-700 transition">← 데이터 수정</button>
                <button onclick="showStep(3)" class="bg-slate-800 text-white px-8 py-3 rounded-xl font-bold hover:bg-slate-900 transition shadow-lg">추천 결과 확인 →</button>
            </div>
        </section>

        <!-- Step 3: Recommendation -->
        <section id="step-3" class="step-content bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
                <div>
                    <h2 class="text-2xl font-bold text-purple-600 mb-2">Step 3. 취향 기반 그룹 리포트</h2>
                    <p class="text-slate-500 text-sm">각 학생과 가장 유사한 취향 벡터를 가진 대상을 보여줍니다.</p>
                </div>
                <div class="mt-4 md:mt-0 px-4 py-2 bg-purple-50 rounded-xl border border-purple-100">
                    <p class="text-[10px] font-bold text-purple-400 uppercase tracking-widest">적용 중인 알고리즘</p>
                    <p id="active-logic-name" class="text-sm font-black text-purple-700">기본 코사인 유사도</p>
                </div>
            </div>
            
            <div id="recommendation-result" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

            <div class="mt-12 p-8 bg-slate-50 rounded-3xl border border-slate-200">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <span class="w-1.5 h-6 bg-purple-500 mr-3 rounded-full"></span>
                    수학적 탐구: 로직에 따른 결과의 변화
                </h3>
                <div class="grid md:grid-cols-2 gap-8">
                    <div>
                        <h4 class="font-bold text-slate-700 mb-2 text-sm">💡 관찰 포인트</h4>
                        <ul class="text-xs text-slate-500 space-y-2 list-disc pl-4">
                            <li>'기본 코사인'에서는 모든 점수가 낮은 학생도 비율만 맞으면 누군가와 매칭될 수 있습니다.</li>
                            <li>'조정된 코사인'으로 바꾸면 변별력 없는 데이터(모두 1점 등)는 매칭에서 제외될 확률이 높습니다.</li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-bold text-slate-700 mb-2 text-sm">🧐 토론 주제</h4>
                        <p class="text-xs text-slate-500 leading-relaxed">추천 시스템의 '신뢰성'을 높이기 위해 수학적으로 데이터를 어떻게 가공하는 것이 옳을까요? 평균을 빼는 것만으로 충분할까요?</p>
                    </div>
                </div>
            </div>

            <div class="mt-8 flex justify-start">
                <button onclick="showStep(2)" class="text-slate-500 font-bold hover:text-slate-700 transition flex items-center">
                    ← 분석 화면으로 돌아가기
                </button>
            </div>
        </section>
    </div>

    <script>
        let students = ["민수", "서윤", "지호", "하은", "준영"];
        const genres = ["SF", "멜로", "공포", "애니", "액션"];
        
        let matrixM = [
            [5, 2, 1, 4, 3],
            [1, 5, 2, 3, 4],
            [4, 1, 5, 2, 1],
            [2, 4, 1, 5, 5],
            [5, 1, 2, 3, 2]
        ];
        
        let currentStep = 1;
        let selectedLogic = 'basic';
        let radarChart = null;

        function showStep(step) {
            document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-dot').forEach(el => el.classList.remove('active'));
            
            const logicSelector = document.getElementById('logic-selector-container');
            if(step === 2 || step === 3) {
                logicSelector.classList.remove('hidden');
            } else {
                logicSelector.classList.add('hidden');
            }

            document.getElementById(`step-${step}`).classList.add('active');
            document.getElementById(`dot-${step}`).classList.add('active');
            
            currentStep = step;
            calculateAndRender();
        }

        function setLogic(logic) {
            selectedLogic = logic;
            document.querySelectorAll('.logic-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`logic-${logic}`).classList.add('active');
            
            const logicNameDisplay = document.getElementById('active-logic-name');
            if(logicNameDisplay) {
                logicNameDisplay.innerText = logic === 'basic' ? "기본 코사인 유사도" : "조정된 코사인 유사도";
            }
            
            calculateAndRender();
        }

        function addStudent() {
            const name = prompt("학생 이름을 입력하세요:", `학생 ${students.length + 1}`);
            if (name) {
                students.push(name);
                matrixM.push(genres.map(() => 3));
                renderMatrixM();
            }
        }

        function removeStudent(index) {
            if (students.length <= 2) return;
            students.splice(index, 1);
            matrixM.splice(index, 1);
            renderMatrixM();
        }

        function renderMatrixM() {
            const container = document.getElementById('matrix-m-container');
            let html = `<div class="matrix-grid" style="grid-template-columns: 100px repeat(${genres.length}, 1fr) 60px;">`;
            html += `<div class="cell header-cell italic text-blue-500">M (Raw)</div>`;
            genres.forEach(g => html += `<div class="cell header-cell">${g}</div>`);
            html += `<div class="cell header-cell">삭제</div>`;
            
            matrixM.forEach((row, i) => {
                html += `<div class="cell header-cell text-sm">${students[i]}</div>`;
                row.forEach((val, j) => {
                    html += `<div class="cell border border-slate-100" contenteditable="true" onblur="updateValue(${i},${j},this.innerText)">${val}</div>`;
                });
                html += `<div class="cell"><button onclick="removeStudent(${i})" class="text-red-400 hover:text-red-600 text-xl">×</button></div>`;
            });
            html += `</div>`;
            container.innerHTML = html;
        }

        function updateValue(i, j, val) {
            const num = parseInt(val);
            if (!isNaN(num) && num >= 1 && num <= 5) matrixM[i][j] = num;
        }

        function getCosineSim(vecA, vecB) {
            let dot = 0, nA = 0, nB = 0;
            for (let i = 0; i < vecA.length; i++) {
                dot += vecA[i] * vecB[i];
                nA += vecA[i] * vecA[i];
                nB += vecB[i] * vecB[i];
            }
            return nA === 0 || nB === 0 ? 0 : dot / (Math.sqrt(nA) * Math.sqrt(nB));
        }

        function getAdjustedSim(vecA, vecB) {
            const avA = vecA.reduce((a, b) => a + b, 0) / vecA.length;
            const avB = vecB.reduce((a, b) => a + b, 0) / vecB.length;
            const cA = vecA.map(v => v - avA);
            const cB = vecB.map(v => v - avB);
            return getCosineSim(cA, cB);
        }

        function calculateAndRender() {
            const n = students.length;
            let simMatrix = Array.from({ length: n }, () => Array(n).fill(0));
            for (let i = 0; i < n; i++) {
                for (let j = 0; j < n; j++) {
                    simMatrix[i][j] = selectedLogic === 'basic' ? getCosineSim(matrixM[i], matrixM[j]) : getAdjustedSim(matrixM[i], matrixM[j]);
                }
            }
            if (currentStep === 2) renderHeatmap(simMatrix);
            if (currentStep === 3) renderRecommendations(simMatrix);
        }

        function renderHeatmap(matrix) {
            const container = document.getElementById('heatmap-container');
            const n = students.length;
            let html = `<div class="matrix-grid" style="grid-template-columns: 80px repeat(${n}, 1fr);">`;
            html += `<div class="cell header-cell italic text-emerald-600">Sim Map</div>`;
            students.forEach(s => html += `<div class="cell header-cell text-[10px] break-all px-1">${s}</div>`);
            matrix.forEach((row, i) => {
                html += `<div class="cell header-cell text-[10px] px-1">${students[i]}</div>`;
                row.forEach((val, j) => {
                    const displayVal = i === j ? 1.00 : val.toFixed(2);
                    const color = i === j ? '#10b981' : (val >= 0.5 ? '#6ee7b7' : (val >= 0.1 ? '#d1fae5' : '#f8fafc'));
                    const textColor = (i === j || val > 0.6) ? 'white' : 'slate-800';
                    html += `<div class="cell cursor-pointer hover:ring-2 ring-emerald-400 z-10 transition-all font-mono" 
                                style="background-color: ${color}; color: ${textColor};" 
                                onclick="showVisualDetail(${i}, ${j}, ${val})">${displayVal}</div>`;
                });
            });
            html += `</div>`;
            container.innerHTML = html;
        }

        function showVisualDetail(i, j, simValue) {
            const info = document.getElementById('similarity-info');
            const vec1 = matrixM[i];
            const vec2 = matrixM[j];
            
            let plotVec1 = [...vec1];
            let plotVec2 = [...vec2];
            let scaleMax = 5, scaleMin = 0;

            if (selectedLogic === 'adjusted') {
                const av1 = vec1.reduce((a, b) => a + b, 0) / vec1.length;
                const av2 = vec2.reduce((a, b) => a + b, 0) / vec2.length;
                plotVec1 = vec1.map(v => v - av1);
                plotVec2 = vec2.map(v => v - av2);
                scaleMax = 4; scaleMin = -4;
            }

            info.innerHTML = `
                <div class="mb-4">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">취향 벡터 비교</p>
                    <h4 class="text-lg font-black text-slate-800">${students[i]} vs ${students[j]}</h4>
                    <div class="mt-2 text-3xl font-black text-emerald-600">${(simValue * 100).toFixed(1)}% <span class="text-xs font-medium text-slate-400">일치</span></div>
                </div>
                <div class="flex-1 bg-white rounded-xl p-2 border border-slate-100 shadow-inner min-h-[250px]">
                    <canvas id="radarChart"></canvas>
                </div>
                <div class="mt-4 flex gap-4">
                    <div class="text-[9px] font-bold text-blue-500"><span class="inline-block w-2 h-2 bg-blue-500 rounded-full mr-1"></span>${students[i]}</div>
                    <div class="text-[9px] font-bold text-emerald-500"><span class="inline-block w-2 h-2 bg-emerald-500 rounded-full mr-1"></span>${students[j]}</div>
                </div>
            `;

            if (radarChart) radarChart.destroy();
            const ctx = document.getElementById('radarChart').getContext('2d');
            radarChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: genres,
                    datasets: [
                        { label: students[i], data: plotVec1, backgroundColor: 'rgba(59, 130, 246, 0.2)', borderColor: 'rgba(59, 130, 246, 1)', borderWidth: 2, pointRadius: 2 },
                        { label: students[j], data: plotVec2, backgroundColor: 'rgba(16, 185, 129, 0.2)', borderColor: 'rgba(16, 185, 129, 1)', borderWidth: 2, pointRadius: 2 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    scales: { r: { min: scaleMin, max: scaleMax, ticks: { display: false }, grid: { color: '#f1f5f9' }, pointLabels: { font: { size: 9, weight: 'bold' } } } },
                    plugins: { legend: { display: false } }
                }
            });
        }

        function renderRecommendations(simMatrix) {
            const res = document.getElementById('recommendation-result');
            res.innerHTML = "";
            students.forEach((name, i) => {
                let maxSim = -1.1, buddyIdx = -1;
                for (let j = 0; j < students.length; j++) {
                    if (i !== j && simMatrix[i][j] > maxSim) {
                        maxSim = simMatrix[i][j];
                        buddyIdx = j;
                    }
                }
                
                const card = document.createElement('div');
                card.className = "bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col hover:shadow-md transition-all relative overflow-hidden";
                
                if (buddyIdx !== -1 && maxSim > 0.01) {
                    card.innerHTML = `
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-10 h-10 bg-purple-600 text-white rounded-lg flex items-center justify-center font-black">${name[0]}</div>
                            <div class="text-right">
                                <p class="text-[10px] text-slate-400 font-bold uppercase">취향 유사도</p>
                                <p class="text-xl font-black text-purple-600">${(maxSim*100).toFixed(1)}%</p>
                            </div>
                        </div>
                        <p class="text-xs text-slate-500 mb-1 font-medium">${name}님과 가장 비슷한 취향:</p>
                        <h4 class="text-lg font-black text-slate-800 mb-4">${students[buddyIdx]}</h4>
                        <div class="mt-auto pt-4 border-t border-slate-50 flex items-center text-[10px] font-bold text-slate-400 italic">
                            * ${selectedLogic === 'basic' ? '방향성 일치 기반' : '평균 편차 분석 기반'}
                        </div>
                    `;
                } else {
                    card.classList.add('opacity-50', 'bg-slate-50');
                    card.innerHTML = `
                        <p class="text-xs text-slate-400 m-auto text-center font-bold">매칭되는 취향 벡터가<br>존재하지 않습니다.</p>
                    `;
                }
                res.appendChild(card);
            });
        }

        window.onload = () => {
            renderMatrixM();
            showStep(1);
        };
    </script>
</body>
</html>
